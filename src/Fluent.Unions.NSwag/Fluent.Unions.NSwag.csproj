<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fluent.Unions.NSwag</PackageId>
    <Description>NSwag integration for Fluent.Unions: describe Option&lt;T&gt; as a nullable T in the documents generated by NSwag.</Description>
    <PackageTags>result;option;union;nswag;openapi;schema</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSwag.Generation" Version="14.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluent.Unions\Fluent.Unions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
