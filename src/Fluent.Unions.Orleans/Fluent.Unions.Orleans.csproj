<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fluent.Unions.Orleans</PackageId>
    <Description>Orleans integration for Fluent.Unions: serialize an Option&lt;T&gt; in grain calls and state, and refuse to serialize results.</Description>
    <PackageTags>result;option;union;orleans;serialization</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Serialization" Version="10.4.2" />
    <PackageReference Include="Microsoft.Orleans.CodeGenerator" Version="10.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluent.Unions\Fluent.Unions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
