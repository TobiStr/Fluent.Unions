<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fluent.Unions.Verify</PackageId>
    <Description>Verify integration for Fluent.Unions: snapshot a Result, a Result&lt;T&gt;, an Option&lt;T&gt; or a Loadable&lt;T&gt; as readable text, with the error as data and no stack trace.</Description>
    <PackageTags>result;option;union;verify;snapshot;testing</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-11</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Verify" Version="33.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluent.Unions\Fluent.Unions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
