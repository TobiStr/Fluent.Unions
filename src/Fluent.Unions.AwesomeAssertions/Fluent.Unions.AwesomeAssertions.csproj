<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fluent.Unions.AwesomeAssertions</PackageId>
    <Description>AwesomeAssertions integration for Fluent.Unions: assert on the state of a Result, Result&lt;T&gt; and Option&lt;T&gt;, and on the exception inside an error.</Description>
    <PackageTags>result;option;union;awesomeassertions;assertions;testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluent.Unions\Fluent.Unions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
