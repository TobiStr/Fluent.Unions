<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fluent.Unions.Swashbuckle</PackageId>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <Description>Swashbuckle integration for Fluent.Unions: describe Option&lt;T&gt; as a nullable T in the documents generated by Swashbuckle.AspNetCore.</Description>
    <PackageTags>result;option;union;swashbuckle;swagger;openapi;schema</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluent.Unions\Fluent.Unions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
