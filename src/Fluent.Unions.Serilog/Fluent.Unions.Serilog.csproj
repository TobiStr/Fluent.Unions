<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fluent.Unions.Serilog</PackageId>
    <Description>Serilog integration for Fluent.Unions: a destructuring policy that logs results, options and loadables as structured values instead of opaque objects.</Description>
    <PackageTags>result;option;union;serilog;logging;structured-logging</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluent.Unions\Fluent.Unions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
