<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fluent.Unions.NewtonsoftJson</PackageId>
    <Description>Newtonsoft.Json support for Fluent.Unions: converters for Option&lt;T&gt;, for your own unions, and a guard that refuses to serialize results.</Description>
    <PackageTags>result;option;union;json;newtonsoft</PackageTags>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluent.Unions\Fluent.Unions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
