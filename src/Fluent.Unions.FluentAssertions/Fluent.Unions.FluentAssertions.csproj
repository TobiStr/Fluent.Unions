<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fluent.Unions.FluentAssertions</PackageId>
    <Description>FluentAssertions integration for Fluent.Unions: assert on the state of a Result, Result&lt;T&gt; and Option&lt;T&gt;, and on the exception inside an error.</Description>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <PackageTags>result;option;union;fluentassertions;assertions;testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluent.Unions\Fluent.Unions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
