<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fluent.Unions.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for Fluent.Unions: turn Result, Result&lt;T&gt; and Option&lt;T&gt; into HTTP responses with ProblemDetails.</Description>
    <PackageTags>result;option;union;aspnetcore;minimal-api;problem-details</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluent.Unions\Fluent.Unions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
