<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fluent.Unions.Xunit</PackageId>
    <Description>xUnit v3 integration for Fluent.Unions: ResultAssert and OptionAssert for Result, Result&lt;T&gt; and Option&lt;T&gt;.</Description>
    <PackageTags>result;option;union;xunit;assertions;testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluent.Unions\Fluent.Unions.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.assert" Version="4.0.3" />
  </ItemGroup>

</Project>
