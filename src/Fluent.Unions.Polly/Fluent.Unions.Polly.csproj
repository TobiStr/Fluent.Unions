<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fluent.Unions.Polly</PackageId>
    <Description>Polly integration for Fluent.Unions: handle a Result&lt;T&gt; error in a resilience strategy and run a resilience pipeline that returns a Result&lt;T&gt;.</Description>
    <PackageTags>result;option;union;polly;resilience;retry</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Polly.Core" Version="8.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluent.Unions\Fluent.Unions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
