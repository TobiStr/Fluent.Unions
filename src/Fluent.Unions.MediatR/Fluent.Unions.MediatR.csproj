<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fluent.Unions.MediatR</PackageId>
    <Description>MediatR integration for Fluent.Unions: pipeline behaviors that turn an exception or an invalid request into a failed Result&lt;T&gt; instead of throwing.</Description>
    <PackageTags>result;option;union;mediatr;cqrs;pipeline;validation</PackageTags>
    <PackageValidationBaselineVersion />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="15.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluent.Unions\Fluent.Unions.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
